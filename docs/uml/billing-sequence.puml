@startuml
actor "Clinic Staff" as Staff
participant "Receipt UI" as UI
participant AppointmentServlet
participant BillingService as Service
participant AppointmentService
participant BillDao
participant ClinicSettingsDao
database PostgreSQL
Staff -> UI: Open bill
UI -> AppointmentServlet: POST /api/appointments/{number}/bill
AppointmentServlet -> Service: generate(number)
Service -> AppointmentService: get(number)
AppointmentService --> Service: Appointment with treatment price
Service -> BillDao: findByAppointmentId(id)
BillDao -> PostgreSQL: SELECT bill
alt bill already exists
  PostgreSQL --> BillDao: Bill
  BillDao --> Service: Existing bill
  Service --> AppointmentServlet: BillGeneration(created=false)
  AppointmentServlet --> UI: 200 persisted receipt
else new bill
  PostgreSQL --> BillDao: Empty
  Service -> ClinicSettingsDao: consultationFee()
  ClinicSettingsDao -> PostgreSQL: SELECT consultation fee
  PostgreSQL --> ClinicSettingsDao: Fee
  Service -> Service: treatment price + consultation fee
  Service -> BillDao: save(bill)
  BillDao -> PostgreSQL: INSERT bill
  PostgreSQL --> BillDao: Bill ID
  Service --> AppointmentServlet: BillGeneration(created=true)
  AppointmentServlet --> UI: 201 persisted receipt
end
UI -> UI: Display or print receipt
@enduml
